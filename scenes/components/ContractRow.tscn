[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/components/ContractRow.gd" id="1_row"]

[node name="ContractRow" type="PanelContainer"]
theme_type_variation = &"Card"
script = ExtResource("1_row")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Caption" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Контракт недели"

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "—"

[node name="Bar" type="ProgressBar" parent="VBox"]
custom_minimum_size = Vector2(0, 18)
layout_mode = 2
show_percentage = false

[node name="Info" type="Label" parent="VBox"]
layout_mode = 2
autowrap_mode = 3

[node name="Details" type="Button" parent="VBox"]
theme_type_variation = &"ButtonBlue"
custom_minimum_size = Vector2(0, 60)
layout_mode = 2
text = "Подробнее"
