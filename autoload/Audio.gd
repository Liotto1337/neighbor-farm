extends Node
## Ambient music (looping pad + random birdsong) and one-shot sound effects on their own buses.
## Everything is muted while the game is in the background or an ad is showing (Yandex Games
## requirement). The player's music / sound toggles persist in user://settings.cfg.
## Sounds are generated by tools/make_audio.py; levels and timings live in config.json "audio".

const AUDIO_DIR: String = "res://audio/"
const SETTINGS_PATH: String = "user://settings.cfg"
const MUSIC_BUS: StringName = &"Music"
const SFX_BUS: StringName = &"Sfx"
const SILENT_DB: float = -60.0
const SFX_IDS: Array[String] = [
	"click", "tab", "modal_open", "modal_close", "deny", "plow", "plant", "harvest", "clear",
	"tock", "coin", "build", "level_up", "expand",
]
const BIRD_COUNT: int = 3
const BIRD_PITCH: Vector2 = Vector2(0.88, 1.15)
## Delay before the field-expansion sparkle so it follows the level-up jingle.
const EXPAND_DELAY: float = 0.8
const HARVEST_ALL_ECHOES: int = 3
const HARVEST_ALL_STEP: float = 0.08
const HARVEST_ALL_PITCH: float = 0.06

signal settings_changed

var music_on: bool = true
var sfx_on: bool = true

var _streams: Dictionary = {}
var _birds: Array[AudioStream] = []
var _voices: Array[AudioStreamPlayer] = []
var _next_voice: int = 0
var _last_played: Dictionary = {}
var _music: AudioStreamPlayer = null
var _bird: AudioStreamPlayer = null
var _bird_timer: Timer = null
var _music_tween: Tween = null
var _mute_reasons: Dictionary = {}
## False during boot so the initial state signals (first tab, buildings, ...) stay silent.
var _live: bool = false


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_ensure_bus(MUSIC_BUS)
	_ensure_bus(SFX_BUS)
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index(SFX_BUS), _cfg_f("sfx_db"))
	_load_settings()
	_load_streams()
	_make_players()
	_connect_signals()
	_apply_settings()


# =====================================================================
# Public API
# =====================================================================

## Plays a sound effect. `pitch` is multiplied by a small random jitter; `delay` in seconds.
func play(sound_id: String, pitch: float = 1.0, delay: float = 0.0) -> void:
	if delay > 0.0:
		get_tree().create_timer(delay).timeout.connect(play.bind(sound_id, pitch, 0.0))
		return
	var stream: AudioStream = _streams.get(sound_id)
	if stream == null or not sfx_on:
		return
	var now: int = Time.get_ticks_msec()
	if now - int(_last_played.get(sound_id, -100000)) < int(_cfg_f("repeat_guard_seconds") * 1000.0):
		return
	_last_played[sound_id] = now
	var voice: AudioStreamPlayer = _free_voice()
	var jitter: float = _cfg_f("pitch_jitter")
	voice.stream = stream
	voice.pitch_scale = pitch * randf_range(1.0 - jitter, 1.0 + jitter)
	voice.volume_db = float(_cfg_dict("volumes_db").get(sound_id, 0.0))
	voice.play()


## Harvest of several tiles at once: a quick rising cluster instead of a single pluck.
func play_harvest_many(count: int) -> void:
	for i: int in mini(count, HARVEST_ALL_ECHOES):
		_last_played.erase("harvest")
		play("harvest", 1.0 + HARVEST_ALL_PITCH * float(i), HARVEST_ALL_STEP * float(i))


func set_music_on(value: bool) -> void:
	music_on = value
	_apply_settings()
	_save_settings()


func set_sfx_on(value: bool) -> void:
	sfx_on = value
	_apply_settings()
	_save_settings()


# =====================================================================
# Setup
# =====================================================================

func _ensure_bus(bus_name: StringName) -> void:
	if AudioServer.get_bus_index(bus_name) >= 0:
		return
	AudioServer.add_bus()
	var index: int = AudioServer.bus_count - 1
	AudioServer.set_bus_name(index, bus_name)
	AudioServer.set_bus_send(index, &"Master")


func _load_streams() -> void:
	for sound_id: String in SFX_IDS:
		var stream: AudioStream = _load_stream(sound_id)
		if stream != null:
			_streams[sound_id] = stream
	for i: int in BIRD_COUNT:
		var bird: AudioStream = _load_stream("bird_%d" % (i + 1))
		if bird != null:
			_birds.append(bird)


## Loads audio/<name>.ogg or audio/<name>.wav, whichever exists.
func _load_stream(file_name: String) -> AudioStream:
	for ext: String in ["ogg", "wav"]:
		var path: String = "%s%s.%s" % [AUDIO_DIR, file_name, ext]
		if ResourceLoader.exists(path):
			return load(path)
	push_error("Audio: missing sound '%s'" % file_name)
	return null


func _make_players() -> void:
	for i: int in maxi(1, int(_cfg_f("sfx_voices"))):
		var voice: AudioStreamPlayer = AudioStreamPlayer.new()
		voice.bus = SFX_BUS
		add_child(voice)
		_voices.append(voice)
	_music = AudioStreamPlayer.new()
	_music.bus = MUSIC_BUS
	_music.stream = _looping(_load_stream("ambient"))
	# Fallback for a WAV imported without its loop points.
	_music.finished.connect(_music.play)
	add_child(_music)
	_bird = AudioStreamPlayer.new()
	_bird.bus = MUSIC_BUS
	add_child(_bird)
	_bird_timer = Timer.new()
	_bird_timer.one_shot = true
	_bird_timer.timeout.connect(_on_bird_timer)
	add_child(_bird_timer)


func _looping(stream: AudioStream) -> AudioStream:
	if stream is AudioStreamOggVorbis:
		(stream as AudioStreamOggVorbis).loop = true
	return stream


func _connect_signals() -> void:
	Signals.state_loaded.connect(_on_state_loaded)
	Signals.tab_requested.connect(_on_live.bind("tab").unbind(1))
	Signals.modal_requested.connect(_on_live.bind("modal_open").unbind(2))
	Signals.modal_close_requested.connect(_on_live.bind("modal_close"))
	Signals.buildings_changed.connect(_on_live.bind("build"))
	Signals.level_up.connect(_on_level_up.unbind(1))
	Signals.field_expanded.connect(_on_field_expanded.unbind(1))
	Signals.ad_started.connect(_set_muted.bind("ad", true).unbind(1))
	Signals.ad_rewarded_completed.connect(_set_muted.bind("ad", false))
	Signals.ad_interstitial_closed.connect(_set_muted.bind("ad", false))
	Signals.ad_failed.connect(_set_muted.bind("ad", false).unbind(2))


# =====================================================================
# Events
# =====================================================================

func _on_state_loaded() -> void:
	_start_music()
	_schedule_bird()
	_go_live.call_deferred()


func _go_live() -> void:
	_live = true


func _on_live(sound_id: String) -> void:
	if _live:
		play(sound_id)


func _on_level_up() -> void:
	if not _live:
		return
	play("level_up")
	_duck()


func _on_field_expanded() -> void:
	if _live:
		play("expand", 1.0, EXPAND_DELAY)


func _notification(what: int) -> void:
	match what:
		NOTIFICATION_APPLICATION_FOCUS_OUT:
			_set_muted("focus", true)
		NOTIFICATION_APPLICATION_FOCUS_IN:
			_set_muted("focus", false)
		NOTIFICATION_APPLICATION_PAUSED:
			_set_muted("paused", true)
		NOTIFICATION_APPLICATION_RESUMED:
			_set_muted("paused", false)


# =====================================================================
# Music
# =====================================================================

func _start_music() -> void:
	if _music.stream == null or _music.playing:
		return
	_music.volume_db = SILENT_DB
	_music.play()
	_fade_music(_cfg_f("music_db"), _cfg_f("music_fade_seconds"))


func _fade_music(target_db: float, seconds: float) -> Tween:
	if _music_tween != null and _music_tween.is_valid():
		_music_tween.kill()
	_music_tween = create_tween()
	_music_tween.tween_property(_music, "volume_db", target_db, seconds).set_trans(Tween.TRANS_SINE)
	return _music_tween


## Lowers the music under a jingle and brings it back.
func _duck() -> void:
	var seconds: float = _cfg_f("duck_seconds")
	var tween: Tween = _fade_music(_cfg_f("music_db") + _cfg_f("duck_db"), seconds)
	tween.tween_interval(seconds * 3.0)
	tween.tween_property(_music, "volume_db", _cfg_f("music_db"), seconds * 3.0).set_trans(Tween.TRANS_SINE)


func _schedule_bird() -> void:
	var range_s: Array = _cfg("bird_interval_seconds", [10, 25])
	_bird_timer.start(randf_range(float(range_s[0]), float(range_s[1])))


func _on_bird_timer() -> void:
	if music_on and not _birds.is_empty() and not _bird.playing:
		_bird.stream = _birds.pick_random()
		_bird.pitch_scale = randf_range(BIRD_PITCH.x, BIRD_PITCH.y)
		_bird.volume_db = _cfg_f("bird_db")
		_bird.play()
	_schedule_bird()


# =====================================================================
# Mute / settings
# =====================================================================

func _set_muted(reason: String, muted: bool) -> void:
	if muted:
		_mute_reasons[reason] = true
	else:
		_mute_reasons.erase(reason)
	AudioServer.set_bus_mute(AudioServer.get_bus_index(&"Master"), not _mute_reasons.is_empty())


func _apply_settings() -> void:
	AudioServer.set_bus_mute(AudioServer.get_bus_index(MUSIC_BUS), not music_on)
	AudioServer.set_bus_mute(AudioServer.get_bus_index(SFX_BUS), not sfx_on)
	settings_changed.emit()


func _load_settings() -> void:
	var file: ConfigFile = ConfigFile.new()
	if file.load(SETTINGS_PATH) != OK:
		return
	music_on = bool(file.get_value("audio", "music", true))
	sfx_on = bool(file.get_value("audio", "sfx", true))


func _save_settings() -> void:
	var file: ConfigFile = ConfigFile.new()
	file.set_value("audio", "music", music_on)
	file.set_value("audio", "sfx", sfx_on)
	if file.save(SETTINGS_PATH) != OK:
		push_error("Audio: cannot write %s" % SETTINGS_PATH)


func _free_voice() -> AudioStreamPlayer:
	for voice: AudioStreamPlayer in _voices:
		if not voice.playing:
			return voice
	_next_voice = (_next_voice + 1) % _voices.size()
	return _voices[_next_voice]


func _cfg(key: String, fallback: Variant) -> Variant:
	return Economy.cfg_dict("audio").get(key, fallback)


func _cfg_f(key: String) -> float:
	return float(_cfg(key, 0.0))


func _cfg_dict(key: String) -> Dictionary:
	var value: Variant = _cfg(key, {})
	return value if value is Dictionary else {}
